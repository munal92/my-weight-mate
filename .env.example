# Copy to .env and fill in. Everything here is inlined into the JS bundle at
# build time, so only put values here that are safe to be public.
#
# The OpenAI key is deliberately NOT in this list: it lives on the AI proxy
# server. See server/ai-proxy/README.md.

# RevenueCat public SDK keys (safe to ship; they cannot grant entitlements)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Entitlement + offering identifiers as configured in the RevenueCat dashboard
EXPO_PUBLIC_PREMIUM_ENTITLEMENT_ID=premium
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=

# Deployed AI proxy (Cloudflare Worker), e.g. https://ai-proxy.you.workers.dev
EXPO_PUBLIC_AI_PROXY_URL=
